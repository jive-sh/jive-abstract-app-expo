{
  "$schema": "./package.schema.json",
  "license": "MIT",
  "name": "jive-abstract-app-expo",
  "version": "0.1.1",
  "description": "Jive abstract for Expo apps: builds and deploys the web app to EAS Hosting and the Android and iOS apps through EAS Build and EAS Update, for every environment in jive.cicd.deploy.branches",
  "type": "module",
  "peerDependencies": {
    "effect": "^4.0.0",
    "eas-cli": "^25.3.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.0",
    "commander": "^13.1.0",
    "effective-modules": "0.3.1-effect4",
    "jive-abstract-library": "0.1.10"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "effect": "^4.0.0",
    "eas-cli": "^25.3.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "jive:cicd:get-config": "jive-library cicd get-config",
    "jive:cicd:build": "jive-library cicd build",
    "jive:cicd:audit": "tsc --noEmit -p tsconfig.json && bun test src && bun install --cwd test/fixture --frozen-lockfile && bun test ./test",
    "jive:cicd:deploy:url": "jive-library cicd deploy-url",
    "jive:cicd:upload-artifacts": "jive-library cicd upload-artifacts",
    "jive:cicd:deploy": "jive-library cicd deploy",
    "dev": "jive-library dev",
    "test": "bun test src",
    "test:hooks": "bun test ./test"
  },
  "jive": {
    "cicd": {
      "deploy": {
        "verb": "Publish Tag",
        "branches": {
          "main": [
            "latest"
          ]
        },
        "previews": false,
        "sequentially": true
      },
      "runsOnPullRequests": true,
      "runsOn": "ubuntu-latest",
      "requiredSecrets": [
        "NPM_TOKEN"
      ]
    },
    "library": {
      "daemons": []
    }
  }
}
